{
  "name": "invoicehub",
  "version": "1.0.0",
  "description": "InvoiceHub - Multi-Business Invoice Generation Platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "postinstall": "cd server && npx prisma generate",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npx prisma generate",
    "build": "npm run build:server && npm run build:client",
    "vercel-build": "npm run build:server && npm run build:client",
    "db:push": "cd server && npx prisma db push",
    "db:seed": "cd server && node prisma/seed.js",
    "db:studio": "cd server && npx prisma studio",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "start": "cd server && npm run start"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sparticuz/chromium": "^131.0.1",
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "prisma": "^5.22.0",
    "puppeteer-core": "^23.9.0",
    "qrcode": "^1.5.4",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.68.0",
    "@rollup/rollup-linux-x64-musl": "^4.68.0"
  }
}
