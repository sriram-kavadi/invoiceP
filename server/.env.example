# ==============================================================================
# InvoiceHub - Supabase & Vercel Environment Variables
# ==============================================================================

# Supabase Connection Strings:
# In Supabase: Go to Project Settings -> Database -> Connection String
# Select "URI" tab.

# 1. DATABASE_URL: Transaction Mode / Pooled Connection (Port 6543)
# Used by the application at runtime for fast serverless connection pooling
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Session Mode / Direct Connection (Port 5432)
# Used by Prisma CLI for migrations and schema push
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Secret (generate a secure random 32+ character string)
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# App Environment
PORT=3001
NODE_ENV="production"

# Client URL (your Vercel production domain, e.g. https://invoicehub.vercel.app)
CLIENT_URL="https://your-invoicehub-domain.vercel.app"

# Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# Optional: Email SMTP settings for password resets
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
